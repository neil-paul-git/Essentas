# Copy to .env and fill in. Restart `npx expo start` after changing it.
# EXPO_PUBLIC_ values are bundled into the app, so never put secrets here.

# Base URL of the FastAPI backend, without /api/v1.
# On a real phone, use your PC's local IP (run `ipconfig`), not localhost,
# and start the backend with: uvicorn app.main:app --reload --host 0.0.0.0
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
