# Copy to backend/.env and adjust. Never commit .env.
APP_NAME=Essentas API
APP_VERSION=0.1.0
# One of: dev, test, prod
ENVIRONMENT=dev

# Supabase dashboard -> Connect -> "Session pooler" connection string.
# A plain postgresql:// URL is fine; the app switches it to the psycopg 3 driver.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
